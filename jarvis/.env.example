# JARVIS environment. Copy to .env (never commit .env).
# Everything here is optional; defaults live in config/*.yaml.

# Backend address (Electron and the backend both read these).
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8765
# JARVIS_BACKEND_URL=http://127.0.0.1:8765

# auto | windows | simulated  (auto = windows on Windows, simulated elsewhere)
# JARVIS_SYSTEM_BACKEND=auto

# Where SQLite and logs live (default: ./data)
# JARVIS_DATA_DIR=

# Python used by Electron to start the backend (default: backend/.venv)
# JARVIS_PYTHON=

# JARVIS_LOG_LEVEL=INFO

# Claude — JARVIS's reasoning (models in config/models.yaml, routing in config/ai.yaml).
# Recommended: use your Claude plan (Settings → AI & Billing). An API key pasted there is
# stored in the OS keystore (macOS Keychain), not here; a key set here is moved into the
# keystore on the next start and is used only after you approve paid API fallback.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
