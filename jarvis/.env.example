# JARVIS environment. Copy to .env (never commit .env).
# Everything here is optional; defaults live in config/*.yaml.

# Backend address (Electron and the backend both read these).
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8765
# JARVIS_BACKEND_URL=http://127.0.0.1:8765

# auto | windows | simulated  (auto = windows on Windows, simulated elsewhere)
# JARVIS_SYSTEM_BACKEND=auto

# Where SQLite and logs live (default: ./data)
# JARVIS_DATA_DIR=

# Python used by Electron to start the backend (default: backend/.venv)
# JARVIS_PYTHON=

# JARVIS_LOG_LEVEL=INFO

# Model providers (Phase 3). Keys are read from the environment only.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
